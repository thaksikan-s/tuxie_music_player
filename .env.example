# Supabase project settings used by scripts/import-music.ps1.
# Copy these into the current PowerShell process only; never commit real values.
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-your-service-role-secret
SUPABASE_MUSIC_BUCKET=music-library

# The Tuxie Settings screen separately accepts the project's PUBLIC
# anon/publishable key. Never paste the service-role secret into the app.
